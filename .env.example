# Copy to `.env` on the host (never commit real values).
# Full secret split / migrate workflow: To-do A8.

# Public hostname for Caddy TLS (e.g. ledger.example.com)
DOMAIN=localhost

# Supabase Postgres — API + worker only
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Production auth (fail-closed when NODE_ENV=production)
AGENT_API_KEY=change-me-agent
ADMIN_API_TOKEN=change-me-admin

# Telegram bot — bot service only
TG_BOT_API_TOKEN=change-me-telegram
TELEGRAM_BOT_USERNAME=YourBotUsername

# Optional overrides (Compose sets these for containers when omitted):
# REDIS_URL=redis://redis:6379
# API_BASE_URL=http://api:7871/api/
