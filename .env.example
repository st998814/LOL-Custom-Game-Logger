# =============================================================================
# LoL Duel Ledger — Compose / EC2 host env template (REQ-OPS-05)
# =============================================================================
# Copy to `.env` on the instance (never commit real values):
#   cp .env.example .env
#
# Least-privilege map (who receives what in docker-compose.yml):
#
# | Variable              | api | worker | bot | caddy | migrate |
# |-----------------------|-----|--------|-----|-------|---------|
# | DOMAIN                |     |        |     |  Y    |         |
# | DATABASE_URL          |  Y  |   Y    |     |       |         |
# | DIRECT_URL            |     |        |     |       |    Y    |
# | REDIS_URL             |  Y* |        |     |       |         |
# | AGENT_API_KEY         |  Y  |        |     |       |         |
# | ADMIN_API_TOKEN       |  Y  |        |     |       |         |
# | TELEGRAM_BOT_USERNAME |  Y  |        |     |       |         |
# | TG_BOT_API_TOKEN      |     |        |  Y  |       |         |
# | API_BASE_URL          |     |        |  Y* |       |         |
#
# (*) Compose hard-codes REDIS_URL / API_BASE_URL for containers; listed for clarity.
# Bot and Caddy never receive database credentials.
# DIRECT_URL is migrate-only — not injected into long-running api/worker.

# --- Edge / TLS ---
DOMAIN=ledger.example.com

# --- Supabase Postgres ---
# Runtime (transaction pooler, typically port 6543)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Migrations only (direct connection, typically port 5432) — migrate profile
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Production auth (fail-closed when NODE_ENV=production) ---
AGENT_API_KEY=change-me-long-random-agent-key
ADMIN_API_TOKEN=change-me-long-random-admin-token

# --- Telegram ---
TG_BOT_API_TOKEN=change-me-from-botfather
TELEGRAM_BOT_USERNAME=YourBotUsername

# --- Reference only (Compose sets these inside the stack) ---
# REDIS_URL=redis://redis:6379
# API_BASE_URL=http://api:7871/api/
# NODE_ENV=production
