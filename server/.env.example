# Local / laptop application-tier env (REQ-OPS-01 dogfood).
# Copy to server/.env or repo-root .env (server loads ../.env from src/).
# Never commit real credentials.

# Runtime Prisma (pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# Prisma migrate / prisma.config.ts (direct)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Account linking tokens (local Redis)
REDIS_URL=redis://localhost:6379

# Optional local auth (omit both for open laptop topology; required in production)
# AGENT_API_KEY=
# ADMIN_API_TOKEN=

# Deep-link bot username used when issuing Telegram links
TELEGRAM_BOT_USERNAME=YourBotUsername
