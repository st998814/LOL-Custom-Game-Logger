generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

enum RawEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Match {
  gameId            Int    @id @map("game_id")
  gameDuration      Int       @map("game_duration")
  gameCreationDate  DateTime  @map("game_creation_date") @db.Timestamptz(6)
  winningTeamId     Int       @map("winning_team_id")

  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  matchPlayers      MatchPlayer[]

  @@index([gameCreationDate(sort: Desc)], map: "matches_game_creation_date_idx")
  @@map("matches")
}

model Player {
  playerId   String   @id @default(uuid()) @map("player_id") @db.Uuid
  tgId Int? @unique @map("tg_id")

  // IMPORTANT:
  // - In Postgres, UNIQUE + NULL is fine (multiple NULLs allowed).
  // - So keep puuid nullable, and normalize "0000...0000" / "" to null in your client/parser.
  puuid      String?  @unique @map("puuid")
  gameName   String?  @map("game_name")
  tagLine    String?  @map("tag_line")

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  matchPlayers MatchPlayer[]

  @@map("players")
}

model MatchPlayer {
  // Composite PK: one row per (match, participant_id)
  gameId        Int  @map("game_id")
  participantId Int     @map("participant_id")

  playerId      String  @map("player_id") @db.Uuid
  teamId        Int     @map("team_id")
  championId    Int     @map("champion_id")

  firstBlood    Boolean @default(false) @map("first_blood")
  firstTower    Boolean @default(false) @map("first_tower")
  totalCs       Int     @default(0) @map("total_cs")

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  match   Match  @relation(fields: [gameId], references: [gameId], onDelete: Cascade)
  player  Player @relation(fields: [playerId], references: [playerId], onDelete: Cascade)

  @@id([gameId, participantId], map: "match_players_pk")

  // Enforce 1v1 per match: only one row per teamId (100/200) per game
  @@unique([gameId, teamId], map: "match_players_game_team_unique")

  @@index([playerId], map: "match_players_player_id_idx")
  @@index([gameId], map: "match_players_game_id_idx")

  @@map("match_players")
}

model RawEvent {
  id               BigInt         @id @default(autoincrement()) @map("id") @db.BigInt
  eventType        String         @map("event_type")
  payload          Json           @map("payload")
  status           RawEventStatus @default(PENDING) @map("status")
  receivedAt       DateTime       @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime?      @map("processed_at") @db.Timestamptz(6)
  retryCount       Int            @default(0) @map("retry_count")
  errorMessage     String?        @map("error_message")
  deduplicationKey String?        @map("deduplication_key")

  @@index([status, receivedAt(sort: Asc)], map: "raw_events_status_received_idx")
  @@index([eventType], map: "raw_events_event_type_idx")
  @@unique([deduplicationKey], map: "raw_events_dedupe_key_unique")
  @@map("raw_events")
}